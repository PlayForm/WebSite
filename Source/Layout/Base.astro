---
import Footer from "@Component/Footer.astro";
import Header from "@Component/Header.astro";

import "@Stylesheet/Base.css";
import "@Stylesheet/Global.css";

import Favicon from "@playform/favicon/Favicon";
import { Head } from "astro-capo";

const {
	Font = [],
	Title = "PlayForm ☁️",
	Description = "Cloud ☁️",
} = Astro.props;

interface Props {
	Font?: string[];
	Title?: string;
	Description?: string;
}

const Link = (Link: string[] = []) =>
	Link.map(
		(Link) => `<link rel="stylesheet" type="text/css"
			href="${Link}" />`,
	).join("\n");
---

<!doctype html>
<html lang="en" class="no-js" dir="ltr">
	<Head>
		<script is:inline>(function(w,d){var h=null;try{var l=w.localStorage,p=JSON.parse(l.getItem("lv:vp:"+"lv_pub_gshkrtlpaijdke91zgxgdoan")||"[]"),q=(location.pathname||"/").replace(/\/{2,}/g,"/").replace(/(.)\/+$/,"$1");if(p.indexOf(q)>=0){w.__lvHeld=1;h=d.createElement("style");h.textContent="html{opacity:0!important}";d.head.appendChild(h)}}catch(e){}w.__lvReveal=function(){if(h&&h.parentNode)h.parentNode.removeChild(h);h=null};setTimeout(function(){if(h)w.__lvLate=1;w.__lvReveal()},300);var s=d.createElement("script");s.src="https://lettervisit.com/v.js?k=lv_pub_gshkrtlpaijdke91zgxgdoan";s.async=true;s.setAttribute("data-key","lv_pub_gshkrtlpaijdke91zgxgdoan");s.onerror=w.__lvReveal;d.head.appendChild(s)})(window,document)</script>
		<script>
			document.documentElement.classList.remove("no-js");
			document.documentElement.classList.add("js");
		</script>

		<!-- Meta -->
		<title>{Title}</title>
		<meta charset="utf-8" />

		<meta name="description" content={Description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="twitter:dnt" content="on" />

		<!-- Links -->
		<link
			rel="preconnect"
			href="https://fonts.googleapis.com"
			crossorigin
		/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" type="text/css" href="/Font/AlbertSans400.css" />
		<link rel="stylesheet" type="text/css" href="/Font/AlbertSans500.css" />

		<slot name="Head" />

		<Fragment set:html={Link(Font.map((Font: any) => Font))} />

		<!-- Favicon -->
		<Favicon Path="/Favicon/" AppTitle={Title} />
	</Head>
	<body class="flex grow flex-col">
		<div id="header" class="grow">
			<Header />
		</div>
		<div id="main" class="grow">
			<slot />
		</div>
		<div id="footer" class="shrink">
			<Footer />
		</div>
		<script>
			import "@Script/Firebase";
		</script>
		<a
			class="absolute left-0 top-0 hidden"
			rel="me"
			href="https://mastodon.social/@nikolahristov"></a>
	</body>
</html>

---
import Base from "@Layout/Base.astro";

import "@Stylesheet/Component/Article.css";

interface Props {
	Slug?: string;
}

export const Capitalize = (Text: string) =>
	Text.replace(/\b\w/g, (Text) => Text.toUpperCase());

export const getStaticPaths = async () =>
	[
		"GDPR",
		"Gdpr",
		"PERSONAL DATA PROTECTION POLICY",
		"PERSONAL-DATA-PROTECTION-POLICY",
		"PRIVACY POLICY",
		"PRIVACY-POLICY",
		"Personal Data Protection Policy",
		"Personal-Data-Protection-Policy",
		"Privacy Policy",
		"Privacy-Policy",
		"TERMS OF SERVICE",
		"TERMS-OF-SERVICE",
		"Terms Of Service",
		"Terms-Of-Service",
		"Terms-of-Service",
		"gdpr",
		"personal data protection policy",
		"personal-data-protection-policy",
		"privacy policy",
		"privacy-policy",
		"terms of service",
		"terms-of-service",
	].map((slug) => ({
		params: { slug },
	}));

// Get the slug from Astro.params (dynamic route parameter)
const pageSlug = (
	typeof Astro.params !== "undefined" &&
	typeof Astro.params["slug"] === "string"
		? Astro.params["slug"]
		: typeof Astro.props !== "undefined" &&
			  typeof Astro.props["Slug"] === "string"
			? Astro.props["Slug"]
			: ""
)
	.toLowerCase()
	.replaceAll(" ", "-");

// Define the type for imported markdown files
interface MarkdownContent {
	compiledContent: () => Promise<string>;
	frontmatter: Record<string, any>;
	file: string;
}

const Files = Object.values(
	import.meta.glob<MarkdownContent>("./../Content/en/*.md", { eager: true }),
) as MarkdownContent[];

const matchedFiles = Files.filter((page) => {
	// Extract filename without extension and normalize
	const fileName = page.file.split("/").pop()?.replace(".md", "") || "";
	const normalizedFileName = fileName.toLowerCase().replaceAll(" ", "-");

	// Exact match logic
	if (pageSlug === "gdpr") {
		return normalizedFileName === "personal-data-protection-policy";
	}
	return normalizedFileName === pageSlug;
});

let Content: string,
	Title = "";

const File = matchedFiles[0];

if (File !== undefined && File !== null) {
	Content = await File.compiledContent();
	Title = File.frontmatter["Title"] ?? "";
} else {
	Content = "Not found.";
	Title = "404.";
}
---

<Base
	Font={[
		"/Font/AlbertSans500.css",
		"/Font/AlbertSans600.css",
		"/Font/AlbertSans700.css",
		"/Font/AlbertSans800.css",
		"/Font/AlbertSans900.css",
	]}
	{Title}>
	<div class="flex flex-col">
		<main class="flex grow justify-center">
			<div class="flex grow self-center">
				<div class="container sm:pb-36">
					<article class="article">
						<Fragment set:html={Content} />
					</article>
				</div>
			</div>
		</main>
	</div>
</Base>
